<script>
  import { requestQaSession, saveQaHistory, toQaProduct } from '@antv/site/qa';

  document.querySelectorAll('[data-g2-entry]').forEach((entry) => {
    if (!(entry instanceof HTMLFormElement)) return;

    entry.addEventListener('submit', async (event) => {
      event.preventDefault();
      const prompt = entry.querySelector('[data-g2-prompt]');
      const submit = entry.querySelector('[data-g2-submit]');
      const stackInput = entry.querySelector('[data-g2-stack]');
      const errorTarget = entry.querySelector('[data-g2-error]');
      if (
        !(prompt instanceof HTMLTextAreaElement) ||
        !(submit instanceof HTMLButtonElement) ||
        !(stackInput instanceof HTMLInputElement) ||
        !(errorTarget instanceof HTMLElement)
      ) return;

      const query = prompt.value.trim();
      if (!query) {
        prompt.focus();
        return;
      }

      const serviceBaseUrl = entry.dataset.qaServiceBase;
      const resultUrl = entry.dataset.resultUrl;
      const stack = stackInput.value.trim();
      const product = toQaProduct(stack);
      if (!serviceBaseUrl || !resultUrl || !product) return;

      entry.setAttribute('aria-busy', 'true');
      submit.disabled = true;
      prompt.readOnly = true;
      errorTarget.hidden = true;

      try {
        const session = await requestQaSession({
          context: {
            locale: document.documentElement.lang.startsWith('en') ? 'en-US' : 'zh-CN',
            product,
          },
          errors: {
            blocked: entry.dataset.popupBlocked || '',
            closed: entry.dataset.popupClosed || '',
            request: entry.dataset.requestError || '',
            timeout: entry.dataset.popupTimeout || '',
          },
          message: query,
          serviceBaseUrl,
        });
        const target = new URL(resultUrl, window.location.origin);
        target.searchParams.set('q', query);
        target.searchParams.set('stack', stack);
        target.searchParams.set('session', session);
        saveQaHistory({ session, stack, title: query });
        window.location.assign(target);
      } catch (error) {
        errorTarget.textContent =
          error instanceof Error ? error.message : entry.dataset.requestError || '';
        errorTarget.hidden = false;
        entry.removeAttribute('aria-busy');
        prompt.readOnly = false;
        submit.disabled = false;
      }
    });
  });
</script>

