---
interface Props {
  locale: 'zh' | 'en';
  config: any;
}

const { locale, config } = Astro.props as Props;
const isZh = locale === 'zh';
const qaServiceBaseUrl = config.qa
  ? import.meta.env.DEV
    ? config.qa.service.development
    : config.qa.service.production
  : '';
const qaResultUrl = `/${locale}/${config.qa?.path || 'result'}/`;
const localHref = (href: string) => {
  if (/^(?:https?:)?\/\//.test(href) || href.startsWith('#')) return href;
  if (href.startsWith('/' + locale + '/') || href === '/' + locale + '/') return href;
  return ('/' + locale + (href.startsWith('/') ? href : '/' + href)).replace(/\/$/, '') + '/';
};

const cases = [
  {
    title: isZh ? '多品类月度销售趋势' : 'Monthly sales by product',
    description: isZh ? '折线、阶梯线与标注的组合表达' : 'Lines, step lines, and annotations',
    link: '/examples/general/line/line-series',
    image: '/home/g2-case-line.png',
    visualClass: 'case-visual-line',
  },
  {
    title: isZh ? '品类销售结构洞察' : 'Category mix analysis',
    description: isZh ? '环图标签与比例编码' : 'Donut labels and proportional encoding',
    link: '/examples/general/pie/donut',
    image: '/home/g2-case-donut.png',
    visualClass: 'case-visual-donut',
  },
  {
    title: isZh ? '烟花销售额趋势分析' : 'Firework sales trend',
    description: isZh ? '面积图、注释与数据故事' : 'Area chart, annotations, and story',
    link: '/examples/annotation/line/anomaly-area-line',
    image: '/home/g2-gallery.png',
    visualClass: 'case-visual-gallery-top',
  },
  {
    title: isZh ? '历史贸易数据叙事' : 'Historical trade story',
    description: isZh ? '双指标对比与关键事件标注' : 'Dual measures with event annotations',
    link: '/examples/general/dual/line-bar',
    image: '/home/g2-gallery.png',
    visualClass: 'case-visual-gallery-bottom',
  },
];

const updates = [
  {
    mark: 'G2',
    tone: 'violet',
    title: isZh ? '图表介绍全新上线' : 'A new chart guide',
    description: isZh
      ? '从分析目的出发，快速找到适合数据的图表类型。'
      : 'Find a fitting chart type from your analytical goal.',
    link: '/charts/overview',
  },
  {
    mark: '5.x',
    tone: 'blue',
    title: isZh ? 'G2 5.x 版本能力' : 'What is new in G2 5.x',
    description: isZh
      ? '更简洁的 API、更强的组合能力与完整的交互语法。'
      : 'A concise API, stronger composition, and complete interactions.',
    link: '/manual/whats-new/new-version-features',
  },
  {
    mark: '</>',
    tone: 'cyan',
    title: isZh ? 'Spec 函数表达式' : 'Spec function expressions',
    description: isZh
      ? '在纯 JSON Spec 中表达回调逻辑，兼顾开放与可移植。'
      : 'Express callbacks in portable, JSON-friendly specifications.',
    link: '/examples/expr/base/expr',
  },
  {
    mark: '▶',
    tone: 'pink',
    title: isZh ? '动画与数据叙事' : 'Animation and storytelling',
    description: isZh
      ? '用关键帧连接数据变化，让图表自然讲述结论。'
      : 'Connect data changes with keyframes and tell a clear story.',
    link: '/examples/storytelling/storytelling/stocks-keyframe',
  },
  {
    mark: '3D',
    tone: 'orange',
    title: isZh ? '三维可视化扩展' : '3D visualization',
    description: isZh
      ? '在一致的语法中组合相机、光照与三维图形。'
      : 'Compose cameras, lighting, and 3D marks with one grammar.',
    link: '/examples/threed/scatter/camera-animation',
  },
  {
    mark: 'AI',
    tone: 'green',
    title: isZh ? '智能图表推荐' : 'Intelligent chart suggestions',
    description: isZh
      ? '从数据特征出发，自动选择合适的视觉表达。'
      : 'Choose a fitting visual expression from the shape of your data.',
    link: '/examples/intelligent/auto/auto-interval',
  },
  {
    mark: 'GH',
    tone: 'dark',
    title: isZh ? '加入 G2 开源社区' : 'Join the G2 community',
    description: isZh
      ? '提交问题、分享案例，与社区一起构建下一代 G2。'
      : 'Report issues, share examples, and help build the next G2.',
    link: 'https://github.com/antvis/g2',
  },
];

const capabilities = [
  {
    icon: 'compose',
    title: isZh ? '千变万化，自由组合' : 'Composable by design',
    description: isZh
      ? '任何图表，都可以基于图形语法灵活绘制，满足你无限的创意。'
      : 'Build any chart from a flexible visual grammar and keep room for new ideas.',
  },
  {
    icon: 'complete',
    title: isZh ? '专业完备' : 'Professional and complete',
    description: isZh
      ? '大量产品实践之上，提供绘图引擎、完备图形语法与专业设计规范。'
      : 'A complete rendering engine, visual grammar, and design guidance proven in products.',
  },
  {
    icon: 'interactive',
    title: isZh ? '生动，可交互' : 'Animated and interactive',
    description: isZh
      ? '强大的交互语法，助力可视分析，让图表栩栩如生。'
      : 'A powerful interaction grammar for visual analysis that makes charts come alive.',
  },
];

const companies = [
  {
    name: isZh ? '阿里云' : 'Alibaba Cloud',
    brand: 'alicloud',
    symbol: '[-]',
    wordmark: '阿里云',
  },
  {
    name: isZh ? '支付宝' : 'Alipay',
    brand: 'alipay',
    symbol: '支',
    wordmark: '支付宝',
  },
  {
    name: isZh ? '天猫' : 'Tmall',
    brand: 'tmall',
    symbol: '',
    wordmark: 'TMALL天猫',
  },
  {
    name: isZh ? '淘宝网' : 'Taobao',
    brand: 'taobao',
    symbol: '',
    wordmark: '淘宝网',
    submark: 'Taobao.com',
  },
  {
    name: isZh ? '网商银行' : 'MYbank',
    brand: 'mybank',
    symbol: 'M',
    wordmark: '网商银行',
  },
  {
    name: isZh ? '京东' : 'JD.com',
    brand: 'jd',
    symbol: '',
    wordmark: 'JD.COM',
  },
  {
    name: 'YunOS',
    brand: 'yunos',
    symbol: '✣',
    wordmark: 'YUNOS',
  },
  {
    name: isZh ? '菜鸟' : 'Cainiao',
    brand: 'cainiao',
    symbol: 'C',
    wordmark: isZh ? '菜鸟' : 'CAINIAO',
  },
];
---

<div class="g2-home">
  <div class="g2-atmosphere">
    <section class="g2-hero" aria-labelledby="g2-home-title" data-g2-reveal>
      <picture class="g2-hero-media" aria-hidden="true">
        <img
          src="/home/g2-hero-background.png"
          alt=""
          width="2880"
          height="1154"
          decoding="async"
          fetchpriority="high"
        />
      </picture>

      <div class="hero-copy">
        <h1 id="g2-home-title" data-pagefind-meta="title">
          <span class="hero-g2">G2</span><span class="hero-dot" aria-hidden="true">·</span>{isZh
            ? '可视化语法'
            : 'Grammar of Graphics'}
        </h1>
        <p>
          {isZh
            ? 'G2 是一套简洁的渐进式可视化语法，用于构建仪表盘、数据探索以及数据讲故事，结合工业和学术实践，实现图形语法、动画语法和交互语法。'
            : 'G2 is a concise, progressive visualization grammar for dashboards, data exploration, and storytelling, bringing graphics, animation, and interaction into one system.'}
        </p>

        <form
          class="g2-ai-entry"
          role="search"
          data-qa-service-base={qaServiceBaseUrl}
          data-result-url={qaResultUrl}
          data-popup-blocked={isZh
            ? '浏览器阻止了登录窗口，请允许弹窗后重试。'
            : 'The sign-in window was blocked. Allow pop-ups and try again.'}
          data-popup-closed={isZh
            ? '登录窗口已关闭，请重试。'
            : 'The sign-in window was closed. Please try again.'}
          data-request-error={isZh
            ? '暂时无法提交查询，请稍后重试。'
            : 'Unable to submit the query. Please try again later.'}
          data-popup-timeout={isZh
            ? '登录等待超时，请重试。'
            : 'Sign-in timed out. Please try again.'}
          data-g2-entry
        >
          <label class="visually-hidden" for={'g2-ai-query-' + locale}>
            {isZh ? '今天，你想可视化什么？' : 'What would you like to visualize today?'}
          </label>
          <textarea
            id={'g2-ai-query-' + locale}
            rows="2"
            placeholder={isZh ? '今天，你想可视化什么？' : 'What would you like to visualize today?'}
            autocomplete="off"
            required
            data-g2-prompt
          ></textarea>
          <div class="g2-ai-meta">
            <span class="g2-stack">
              <span class="g2-stack-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 4h10l4 7-9 9-9-9 4-7Z"></path>
                  <path d="m7 4 5 16 5-16M3 11h18"></path>
                </svg>
              </span>
              <span>G2</span>
            </span>
            <input type="hidden" value="G2" data-g2-stack />
            <button
              class="g2-ai-submit"
              type="submit"
              aria-label={isZh ? '提交可视化需求' : 'Submit visualization request'}
              disabled
              data-g2-submit
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 12 14-7-4 14-3-5-7-2Z"></path>
                <path d="m12 14 7-9"></path>
              </svg>
            </button>
          </div>
          <p class="g2-ai-error" role="alert" hidden data-g2-error></p>
        </form>
      </div>
    </section>

    <section class="case-section section-inner" aria-labelledby="case-title" data-g2-reveal>
      <header class="section-heading">
        <h2 id="case-title">{isZh ? '精选案例' : 'Selected examples'}</h2>
      </header>
      <div class="case-grid">
        {cases.map((item, index) => (
          <a class="case-card" href={localHref(item.link)} style={'--case-index:' + index}>
            <div class="case-copy">
              <strong>{item.title}</strong>
              <span>{item.description}</span>
            </div>
            <div class="case-frame">
              <img
                class:list={['case-visual', item.visualClass]}
                src={item.image}
                alt=""
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </a>
        ))}
      </div>
    </section>

    <section
      class="updates-section section-inner"
      aria-label={isZh ? 'G2 动态资讯' : 'G2 updates'}
      data-g2-reveal
    >
      <div class="updates-carousel" data-updates-carousel>
        <div class="updates-viewport" data-updates-viewport>
          <div class="updates-track" role="list">
            {updates.map((item) => (
              <a class="update-card" href={localHref(item.link)} role="listitem">
                <span class:list={['update-mark', 'update-mark-' + item.tone]} aria-hidden="true">
                  {item.mark}
                </span>
                <span class="update-copy">
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </span>
                <svg class="update-arrow" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5 10h10M11 6l4 4-4 4"></path>
                </svg>
              </a>
            ))}
          </div>
        </div>
        <div
          class="updates-pagination"
          data-updates-pagination
          aria-label={isZh ? '动态资讯分页' : 'Update pages'}
        ></div>
      </div>
    </section>
  </div>

  <section class="capability-section" aria-label={isZh ? 'G2 核心能力' : 'G2 capabilities'} data-g2-reveal>
    <div class="capability-grid section-inner">
      {capabilities.map((item) => (
        <article class="capability-card">
          <span class="capability-icon" aria-hidden="true">
            {item.icon === 'compose' && (
              <svg viewBox="0 0 28 28">
                <path d="M8 6 3 14l5 8M20 6l5 8-5 8M16 4l-4 20"></path>
              </svg>
            )}
            {item.icon === 'complete' && (
              <svg viewBox="0 0 28 28">
                <rect x="4" y="5" width="20" height="7" rx="2"></rect>
                <rect x="4" y="16" width="20" height="7" rx="2"></rect>
                <path d="M8 8.5h8M8 19.5h11"></path>
              </svg>
            )}
            {item.icon === 'interactive' && (
              <svg viewBox="0 0 28 28">
                <rect x="4" y="7" width="13" height="13" rx="2"></rect>
                <rect x="11" y="3" width="13" height="13" rx="2"></rect>
                <path d="m17 19 3 6 2-3 3-2-8-1Z"></path>
              </svg>
            )}
          </span>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="gallery-section" aria-labelledby="gallery-title" data-g2-reveal>
    <div class="gallery-inner section-inner">
      <div class="gallery-copy">
        <span class="gallery-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <path d="m24 5 5.5 11.2L42 18l-9 8.7 2.1 12.3L24 33.2 12.9 39 15 26.7 6 18l12.5-1.8L24 5Z"></path>
          </svg>
        </span>
        <h2 id="gallery-title">{isZh ? '精品 Gallery' : 'Curated Gallery'}</h2>
        <p>
          {isZh
            ? '真实的数据可视化案例，我们将它们归纳为一个个故事性的设计模板，让用户达到开箱即用的效果。'
            : 'Real visualization cases distilled into story-driven design patterns that are ready to use.'}
        </p>
        <a class="gallery-action" href={localHref('/examples')}>
          <span>{isZh ? '查看详情' : 'View gallery'}</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 6l4 4-4 4"></path>
          </svg>
        </a>
      </div>
      <div class="gallery-visual">
        <div class="gallery-glow" aria-hidden="true"></div>
        <img
          src="/home/g2-gallery.png"
          alt={isZh ? '由多个真实 G2 图表组成的 Gallery 预览' : 'Gallery preview made from real G2 charts'}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="trust-section" aria-labelledby="trust-title" data-g2-reveal>
    <div class="trust-inner">
      <h2 id="trust-title">{isZh ? '感谢信赖' : 'Trusted by teams'}</h2>
      <div
        class="trust-viewport"
        tabindex="0"
        aria-label={isZh ? '使用 G2 的企业品牌' : 'Companies using G2'}
      >
        <div class="trust-track">
          <div class="trust-group" role="list">
            {companies.map((company) => (
              <div class:list={['trust-logo', 'trust-logo-' + company.brand]} role="listitem" aria-label={company.name}>
                {company.symbol && <span class="trust-symbol" aria-hidden="true">{company.symbol}</span>}
                <span class="trust-wordmark" aria-hidden="true">
                  <strong>{company.wordmark}</strong>
                  {company.submark && <small>{company.submark}</small>}
                </span>
              </div>
            ))}
          </div>
          <div class="trust-group" aria-hidden="true">
            {companies.map((company) => (
              <div class:list={['trust-logo', 'trust-logo-' + company.brand]}>
                {company.symbol && <span class="trust-symbol">{company.symbol}</span>}
                <span class="trust-wordmark">
                  <strong>{company.wordmark}</strong>
                  {company.submark && <small>{company.submark}</small>}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-g2-entry]').forEach((entry) => {
      const prompt = entry.querySelector('[data-g2-prompt]');
      const submit = entry.querySelector('[data-g2-submit]');
      if (
        !(entry instanceof HTMLFormElement) ||
        !(prompt instanceof HTMLTextAreaElement) ||
        !(submit instanceof HTMLButtonElement)
      ) return;

      const syncSubmit = () => {
        submit.disabled = !prompt.value.trim();
      };

      entry.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('button, textarea')) return;
        prompt.focus({ preventScroll: true });
      });
      prompt.addEventListener('input', syncSubmit);
      prompt.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' || event.shiftKey || event.isComposing) return;
        event.preventDefault();
        if (prompt.value.trim()) entry.requestSubmit();
      });
      entry.addEventListener('submit', (event) => {
        if (prompt.value.trim()) return;
        event.preventDefault();
        syncSubmit();
        prompt.focus();
      });
      syncSubmit();
    });

    document.querySelectorAll('[data-updates-carousel]').forEach((carousel) => {
      const viewport = carousel.querySelector('[data-updates-viewport]');
      const pagination = carousel.querySelector('[data-updates-pagination]');
      const cards = [...carousel.querySelectorAll('.update-card')];
      if (!(viewport instanceof HTMLElement) || !(pagination instanceof HTMLElement) || !cards.length) return;

      let currentPage = 0;
      let pageCount = 1;
      let pageSize = 3;
      let autoTimer = 0;
      let scrollTimer = 0;
      let wheelTimer = 0;
      let wheelDelta = 0;
      let wheelDirection = 0;
      let wheelGestureActive = false;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const getPageSize = () => {
        if (window.innerWidth < 640) return 1;
        if (window.innerWidth < 920) return 2;
        return 3;
      };

      const syncDots = () => {
        pagination.querySelectorAll('button').forEach((button, index) => {
          button.setAttribute('aria-current', index === currentPage ? 'true' : 'false');
        });
      };

      /** @param {number} page */
      const getPageLeft = (page) => {
        const card = cards[Math.min(page * pageSize, cards.length - 1)];
        const left = card instanceof HTMLElement && cards[0] instanceof HTMLElement
          ? card.offsetLeft - cards[0].offsetLeft
          : page * viewport.clientWidth;
        return Math.min(left, Math.max(0, viewport.scrollWidth - viewport.clientWidth));
      };

      /**
       * @param {number} page
       * @param {boolean} [smooth]
       */
      const goTo = (page, smooth = true) => {
        currentPage = Math.max(0, Math.min(page, pageCount - 1));
        viewport.scrollTo({
          left: getPageLeft(currentPage),
          behavior: smooth && !reducedMotion ? 'smooth' : 'auto',
        });
        syncDots();
      };

      const renderDots = () => {
        pagination.replaceChildren();
        pagination.hidden = pageCount <= 1;
        for (let index = 0; index < pageCount; index += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.setAttribute('aria-label', (document.documentElement.lang === 'zh' ? '查看第 ' : 'View page ') + (index + 1));
          button.addEventListener('click', () => goTo(index));
          pagination.append(button);
        }
        syncDots();
      };

      const rebuild = () => {
        pageSize = getPageSize();
        pageCount = Math.ceil(cards.length / pageSize);
        currentPage = Math.min(currentPage, pageCount - 1);
        renderDots();
        requestAnimationFrame(() => goTo(currentPage, false));
      };

      const stopAuto = () => {
        window.clearInterval(autoTimer);
      };
      const startAuto = () => {
        stopAuto();
        if (reducedMotion || pageCount <= 1) return;
        autoTimer = window.setInterval(() => goTo((currentPage + 1) % pageCount), 5600);
      };

      viewport.addEventListener('scroll', () => {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          let next = 0;
          let nearestDistance = Number.POSITIVE_INFINITY;
          for (let index = 0; index < pageCount; index += 1) {
            const distance = Math.abs(viewport.scrollLeft - getPageLeft(index));
            if (distance >= nearestDistance) continue;
            nearestDistance = distance;
            next = index;
          }
          currentPage = Math.max(0, Math.min(next, pageCount - 1));
          syncDots();
        }, 90);
      }, { passive: true });
      viewport.addEventListener('wheel', (event) => {
        if (event.ctrlKey || pageCount <= 1) return;

        const isHorizontalGesture = Math.abs(event.deltaX) >= Math.abs(event.deltaY);
        if (isHorizontalGesture || event.shiftKey) {
          stopAuto();
          return;
        }

        const delta = event.deltaY;
        if (Math.abs(delta) < 1) return;

        if (wheelGestureActive) {
          event.preventDefault();
          window.clearTimeout(wheelTimer);
          wheelTimer = window.setTimeout(() => {
            wheelGestureActive = false;
          }, 160);
          return;
        }

        const direction = delta > 0 ? 1 : -1;
        const targetPage = currentPage + direction;
        if (targetPage < 0 || targetPage >= pageCount) {
          wheelDelta = 0;
          wheelDirection = 0;
          return;
        }

        event.preventDefault();
        if (direction !== wheelDirection) wheelDelta = 0;
        wheelDirection = direction;
        wheelDelta += delta;
        if (Math.abs(wheelDelta) < 24) return;

        wheelDelta = 0;
        wheelGestureActive = true;
        stopAuto();
        goTo(targetPage);
        window.clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          wheelGestureActive = false;
        }, 160);
      }, { passive: false });
      carousel.addEventListener('pointerenter', stopAuto);
      carousel.addEventListener('pointerleave', startAuto);
      carousel.addEventListener('focusin', stopAuto);
      carousel.addEventListener('focusout', (event) => {
        const { relatedTarget } = /** @type {FocusEvent} */ (event);
        if (relatedTarget instanceof Node && carousel.contains(relatedTarget)) return;
        startAuto();
      });
      window.addEventListener('resize', () => {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          rebuild();
          startAuto();
        }, 120);
      });
      rebuild();
      startAuto();
    });

    const revealItems = [...document.querySelectorAll('[data-g2-reveal]')];
    /** @param {Element} item */
    const reveal = (item) => item.setAttribute('data-g2-visible', '');
    document.documentElement.classList.add('g2-motion-ready');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealItems.forEach(reveal);
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        reveal(entry.target);
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    revealItems.forEach((item, index) => {
      if (index === 0) reveal(item);
      else observer.observe(item);
    });
  })();
